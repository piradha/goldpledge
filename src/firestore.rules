
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function getUserShopId() {
      // Use exists() to handle cases where the user profile might not be created yet.
      let userData = getAfter(/databases/$(database)/documents/users/$(request.auth.uid));
      if (existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))) {
          return userData.data.shopId;
      }
      return request.resource.data.shopId; // during signup, check incoming data
    }
    
    function isAdmin() {
      let userData = getUserData(request.auth.uid);
      return isSignedIn() && 'role' in userData && userData.role == 'admin';
    }

    // ------------------------------------------------------------------------
    // Collection Rules
    // ------------------------------------------------------------------------
    
    match /users/{userId} {
      allow read, update: if isUser(userId) || isAdmin();
      // Allow user creation if the user is signed in and the profile being created is for them.
      // This is necessary for the signup flow.
      allow create: if isUser(userId);
      allow delete: if isAdmin();
    }
    
    match /shops/{shopId} {
      allow read: if isSignedIn();
      // Allow shop creation if the incoming document's ownerId matches the user's uid.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // Generic rule for shop-partitioned data.
    match /{collection}/{docId} 
      where collection in ['customers', 'pledges', 'schemes', 'payments', 'itemTypes'] {
       allow read, write: if isSignedIn() && (
         (request.resource.data.shopId == getUserShopId()) || // Write operations
         (resource.data.shopId == getUserShopId()) ||          // Read operations
         isAdmin()
       );
    }

    match /counters/{counterName} {
       allow read, write: if isSignedIn() && (isAdmin() || counterName.split('_')[1] == getUserShopId());
    }
  }
}
